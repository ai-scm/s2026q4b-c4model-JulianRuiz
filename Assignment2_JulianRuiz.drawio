        </mxCell>
        <mxCell id="ads9c7ijuFf_5Zxhqu6W-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Bot Handler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;[Componente: Agents SDK · AgentApplication (bot.py)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Recibe cada mensaje en /api/messages; el SDK valida antes el token del Bot Framework. Al agregar el bot al equipo, lee la lista de miembros y los registra. El formulario lo pasa a Report Service." vertex="1">
          <mxGeometry height="140" width="260" x="590" y="550" as="geometry" />
        </mxCell>
        <mxCell id="ads9c7ijuFf_5Zxhqu6W-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Teams Sender&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;[Componente: Agents SDK + Adaptive Cards (sender.py)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Envía mensajes 1:1 y publica en el canal. Contiene las plantillas de tarjetas." vertex="1">
          <mxGeometry height="140" width="260" x="910" y="550" as="geometry" />
        </mxCell>
        <mxCell id="ads9c7ijuFf_5Zxhqu6W-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#85BBF0;strokeColor=#78A8D8;fontColor=#000000;fontSize=11;align=center;" value="&lt;b&gt;Daily Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;[Componente: bucle asyncio (scheduler.py)]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Cada minuto compara la hora con el .env: a HORA_DAILY envía el formulario; a HORA_CIERRE revisa faltantes." vertex="1">
