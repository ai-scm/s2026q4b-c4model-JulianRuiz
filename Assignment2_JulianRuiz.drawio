        <mxCell id="ads9c7ijuFf_5Zxhqu6W-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=8 4;fontColor=#333333;fontSize=12;align=left;verticalAlign=bottom;spacingLeft=10;spacingBottom=6;container=0;" value="&lt;b&gt;Bot App&lt;/b&gt; [Contenedor: Python 3.12]" vertex="1">
